<!--
  Guide panel for the mountain experience. Text is swapped at runtime by
  GuideSystem (src/game/guide-system.ts) as the player moves between phases.
  Panel, Divider, Button, ButtonIcon and ButtonLabel come from the bundled
  Horizon kit; Mountain, RectangleGoggles and RotateCcw are Lucide icons.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 380px;
  }

  .panel-content {
    flex-direction: column;
    padding-top: 18px;
    padding-left: 26px;
    padding-right: 26px;
    padding-bottom: 6px;
  }

  .step-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .step {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #3b6ea8;
  }

  .heading {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.5px;
    color: #1f2a37;
    margin-bottom: 10px;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.92);
  }

  .body {
    color: #2d3540;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    width: 100%;
    margin-top: 10px;
    margin-bottom: 12px;
  }

  .body:dark {
    color: rgba(255, 255, 255, 0.88);
  }

  .hint {
    color: #5c6b7c;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    width: 100%;
    margin-bottom: 10px;
  }

  .button {
    justify-content: flex-start;
    margin-left: 26px;
    margin-right: 26px;
    margin-top: 4px;
    margin-bottom: 22px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="step-row">
      <Mountain width="14" height="14" color="#3b6ea8"></Mountain>
      <span id="guide-step" class="step">STEP 1 OF 4</span>
    </div>
    <span id="guide-title" class="heading">Pole up the mountain</span>
    <Divider></Divider>
    <span id="guide-body" class="body">
      Make a fist to grip each walking pole. Plant the tip in the snow and push
      back to stride up the trail.
    </span>
    <span id="guide-hint" class="hint">Hand tracking recommended.</span>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter VR</ButtonLabel>
  </Button>
  <Button id="restart-button" class="button" style="display: none">
    <ButtonIcon>
      <RotateCcw></RotateCcw>
    </ButtonIcon>
    <ButtonLabel class="button-label">Play again</ButtonLabel>
  </Button>
</Panel>
