<!--
  Guide panel for the mountain experience. Text is swapped at runtime by
  GuideSystem (src/game/guide-system.ts) as the player moves between phases.
  Panel, Divider, Button, ButtonIcon and ButtonLabel come from the bundled
  Horizon kit; Mountain, MountainSnow, RectangleGoggles, RotateCcw,
  SkipForward and Undo2 are Lucide icons. The expedition buttons are wired
  in GuideSystem too (src/game/expedition/director/exp-control.ts).
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 300px;
  }

  .header {
    flex-direction: column;
    background-color: #2f6fb5;
    border-radius: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    margin-top: 12px;
    margin-left: 12px;
    margin-right: 12px;
  }

  .panel-content {
    flex-direction: column;
    padding-top: 6px;
    padding-left: 26px;
    padding-right: 26px;
    padding-bottom: 6px;
  }

  .step-row {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    gap: 6px;
    background-color: #ffd257;
    border-radius: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 10px;
    margin-bottom: 8px;
  }

  .step {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #24324a;
  }

  .heading {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.5px;
    color: #ffffff;
  }

  .body {
    color: #2d3540;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    width: 100%;
    margin-top: 10px;
    margin-bottom: 12px;
  }

  .body:dark {
    color: rgba(255, 255, 255, 0.88);
  }

  .metric {
    color: #1f2a37;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.5px;
    width: 100%;
    margin-bottom: 8px;
  }

  .metric:dark {
    color: rgba(255, 255, 255, 0.95);
  }

  .hint {
    color: #5c6b7c;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    width: 100%;
    margin-bottom: 10px;
  }

  .button {
    justify-content: flex-start;
    margin-left: 26px;
    margin-right: 26px;
    margin-top: 4px;
    margin-bottom: 22px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="header">
    <div class="step-row">
      <Mountain width="13" height="13" color="#24324a"></Mountain>
      <span id="guide-step" class="step">STEP 1 OF 4</span>
    </div>
    <span id="guide-title" class="heading">Pole up the trail</span>
  </div>
  <div class="panel-content">
    <span id="guide-body" class="body">Fist to grip. Plant, then pull back.</span>
    <span id="guide-metric" class="metric" style="display: none">79 m to the summit</span>
    <span id="guide-hint" class="hint"></span>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter VR</ButtonLabel>
  </Button>
  <Button id="restart-button" class="button" style="display: none">
    <ButtonIcon>
      <RotateCcw></RotateCcw>
    </ButtonIcon>
    <ButtonLabel class="button-label">Play again</ButtonLabel>
  </Button>
  <Button id="expedition-button" class="button" style="display: none">
    <ButtonIcon>
      <MountainSnow></MountainSnow>
    </ButtonIcon>
    <ButtonLabel class="button-label">Start the Expedition</ButtonLabel>
  </Button>
  <Button id="skip-button" class="button" style="display: none">
    <ButtonIcon>
      <SkipForward></SkipForward>
    </ButtonIcon>
    <ButtonLabel class="button-label">Skip to the next camp</ButtonLabel>
  </Button>
  <Button id="exp-restart-button" class="button" style="display: none">
    <ButtonIcon>
      <RotateCcw></RotateCcw>
    </ButtonIcon>
    <ButtonLabel class="button-label">Restart expedition</ButtonLabel>
  </Button>
  <Button id="tutorial-button" class="button" style="display: none">
    <ButtonIcon>
      <Undo2></Undo2>
    </ButtonIcon>
    <ButtonLabel class="button-label">Back to the tutorial</ButtonLabel>
  </Button>
</Panel>
